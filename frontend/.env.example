# Copy to .env for local development. Do not commit .env.
NEXT_PUBLIC_API_BASE_URL=https://anza-staging-172765911669.africa-south1.run.app/api
NEXT_PUBLIC_NOSTR_OFFER_KIND=9998
# Must match backend NOSTR_ATTESTOR_PUBKEY. Never put a private key here.
NEXT_PUBLIC_NOSTR_ATTESTOR_PUBKEY=
NEXT_PUBLIC_STATUS_POLL_INTERVAL_MS=3000
# Cloudinary public id of the watermark asset used to watermark content previews.
# Two orientation-specific watermarks are supported; the preview picks the one
# matching the creator video's aspect ratio. When neither is set, previews
# render the original URL unchanged (no regression).
# Format: just the Cloudinary public id (no cloud name, version, or extension),
# e.g. Anza-Landscape-Watermark_b6hq1l
NEXT_PUBLIC_WATERMARK_PUBLIC_ID_LANDSCAPE=Anza-Landscape-Watermark_b6hq1l
NEXT_PUBLIC_WATERMARK_PUBLIC_ID_PORTRAIT=Anza-Potrait-Watermark_ulrtxu

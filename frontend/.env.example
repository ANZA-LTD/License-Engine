# BACKEND TEAM: copy this file to `.env.local` once the real API exists.
#
# Base URL of the Next.js API / backend described in the spec (section 12 —
# Backend Architecture). All calls in lib/api.ts are prefixed with this value.
# Leave unset while developing against the mock layer.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# When true, lib/api.ts uses the in-browser mock store instead of calling
# NEXT_PUBLIC_API_BASE_URL. Flip to "false" once real endpoints are live.
NEXT_PUBLIC_USE_MOCK_API=true

# How often the payment page polls GET /api/offers/:offerId/status, in ms.
# Only relevant once polling talks to a real backend (see PaymentStatus flow).
NEXT_PUBLIC_STATUS_POLL_INTERVAL_MS=3000

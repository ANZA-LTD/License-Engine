node_modules/

# Local environment configuration and secrets
.env
.env.*
!.env.example

# Private key and wallet files
*.key
*.pem
*.p12
*.pfx
*.crt
*.secret
secrets/
wallets/

# Local data, database exports, and uploaded media
data/
storage/
uploads/
*.sql
*.dump
*.backup

# ...but migrations are part of the application, not local database exports.
# Without this a fresh clone has no videos/upload_sessions tables.
!src/database/migrations/*.sql

# Test output, logs, and runtime files
coverage/
logs/
*.log
*.pid
.cache/
.tmp/

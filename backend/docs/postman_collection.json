              "raw": "{\n  \"title\": \"Example video\",\n  \"upload_session_id\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"public_id\": \"contentport/videos/example\",\n  \"asset_version\": 1,\n  \"resource_type\": \"video\",\n  \"format\": \"mp4\",\n  \"context\": \"contentport_session=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"status\": \"ready\",\n  \"original_sha256\": null,\n  \"bytes\": 4096,\n  \"duration_seconds\": 30,\n  \"width\": 1920,\n  \"height\": 1080\n}",

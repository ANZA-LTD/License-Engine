    {
      "name": "Offers",
      "item": [
        {
          "name": "List published offers for brand discovery",
          "description": "",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/offers",
              "variable": []
            }
          }
        },
        {
          "name": "Create a creator-owned draft offer",
          "description": "Requires creator Nostr HTTP authorization. Without video_id, provide content_url and content_sha256. With video_id, the video must be owned and ready; the server resolves the canonical media reference and ignores client-supplied content_url or content_sha256.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text",
                "disabled": false
              },
              {
                "key": "Authorization",
                "value": "Nostr {{signedNip98Event}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Example Brand\",\n  \"content_url\": \"https://example.com/watermarked-preview.mp4\",\n  \"content_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"amount_sats\": 25000,\n  \"usage_rights\": \"Non-exclusive organic social use; no paid advertising.\",\n  \"duration\": {\n    \"type\": \"fixed\",\n    \"days\": 30\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/offers",
              "variable": []
            }
          }
        },
        {
          "name": "Read an offer; private drafts require creator authorization",
          "description": "",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/offers/:id",
              "variable": [
                {
                  "key": "id",
                  "value": "{{offerId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Validate and queue the exact creator-signed offer",
          "description": "",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text",
                "disabled": false
              },
              {
                "key": "Authorization",
                "value": "Nostr {{signedNip98Event}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n  \"pubkey\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"created_at\": 1700000000,\n  \"kind\": 9998,\n  \"tags\": [\n    [\n      \"t\",\n      \"contentport-offer-v1\"\n    ]\n  ],\n  \"content\": \"{\\\"schema\\\":\\\"contentport.offer.v1\\\",\\\"terms\\\":{}}\",\n  \"sig\": \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/offers/:id/publish",
              "variable": [
                {
                  "key": "id",
                  "value": "{{offerId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Development payment",
      "item": [
        {
          "name": "Request a local LND invoice for a published offer",
          "description": "Development-only legacy route. It uses the single configured local LND node and does not route to a creator Lightning Address or independently prove creator-beneficiary settlement. Do not use as the production payment path.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/offers/:id/payment",
              "variable": [
                {
                  "key": "id",
                  "value": "{{offerId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Read current offer and local LND payment status",
          "description": "Public legacy status endpoint. A client-visible status is not independent proof of funds movement.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/offers/:id/status",
              "variable": [
                {
                  "key": "id",
                  "value": "{{offerId}}"
                }
              ]
            }
          }
        }
      ]
    },
